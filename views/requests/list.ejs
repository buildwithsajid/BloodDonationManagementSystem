<% var pageTitle = `Blood Requests - BDMS`; %>
<%- include('../common/header', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
<%- include('../common/navbar', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>

<main class="main-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Emergency Blood Requests</h1>
            <p class="page-subtitle">Patient blood demands across participating hospitals and clinics</p>
        </div>
        <% if (loggedInUser != null && loggedInUser.role == 'ADMIN') { %>
            <a href="/blood-requests/create" class="btn btn-primary btn-sm">
                + Create Blood Request
            </a>
        <% } %>
    </div>

    <% if (notEmpty(successMessage)) { %>
        <div class="alert alert-success">
            <span><%= successMessage %></span>
            <button type="button" class="alert-close">&times;</button>
        </div>
    <% } %>

    <!-- Search / Filter Form -->
    <form action="/blood-requests/search" method="get" class="filter-bar">
        <div class="form-group">
            <label class="form-label" for="bloodGroup">Blood Group</label>
            <select id="bloodGroup" name="bloodGroup" class="form-control">
                <option value="">All Blood Groups</option>
                <% (['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']||[]).forEach(function(bg){ %>
                    <option value="<%= bg %>" <%= bloodGroup == bg ? 'selected' : '' %>><%= bg %></option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label class="form-label" for="city">City</label>
            <input type="text" id="city" name="city" class="form-control"
                   value="<%= city %>" placeholder="Filter by city">
        </div>

        <div class="form-group">
            <label class="form-label" for="status">Status</label>
            <select id="status" name="status" class="form-control">
                <option value="">Open Requests (Pending / In Progress)</option>
                <option value="PENDING" <%= status == 'PENDING' ? 'selected' : '' %>>Pending</option>
                <option value="IN_PROGRESS" <%= status == 'IN_PROGRESS' ? 'selected' : '' %>>In Progress</option>
                <option value="FULFILLED" <%= status == 'FULFILLED' ? 'selected' : '' %>>Fulfilled</option>
                <option value="CANCELLED" <%= status == 'CANCELLED' ? 'selected' : '' %>>Cancelled</option>
            </select>
        </div>

        <div style="display: flex; gap: 8px;">
            <button type="submit" class="btn btn-primary">Filter</button>
            <a href="/blood-requests" class="btn btn-outline">Reset</a>
        </div>
    </form>

    <div class="data-table-container">
        
            <% if (notEmpty(bloodRequests)) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Blood Group</th>
                            <th>Patient Name</th>
                            <th>Hospital & City</th>
                            <th>Units</th>
                            <th>Urgency</th>
                            <th>Status</th>
                            <th>Required By</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (bloodRequests||[]).forEach(function(r){ %>
                            <tr>
                                <td>#<%= r.requestId %></td>
                                <td><span class="blood-badge"><%= r.bloodGroup %></span></td>
                                <td style="font-weight: 500;"><%= r.patientName %></td>
                                <td><%= r.hospitalName %>, <%= r.city %></td>
                                <td><strong><%= r.unitsRequired %> unit(s)</strong></td>
                                <td>
                                    <span class="urgency-pill urgency-<%= r.urgency.toString().toLowerCase() %>">
                                        <%= r.urgency %>
                                    </span>
                                </td>
                                <td>
                                    <span class="status-pill status-<%= r.status.toString().toLowerCase().replace('_', '-') %>">
                                        <%= r.status %>
                                    </span>
                                </td>
                                <td style="font-size: 13px; color: var(--text-secondary);">
                                    <%= r.requiredBy != null ? r.requiredBy : 'Immediate' %>
                                </td>
                                <td>
                                    <a href="/blood-requests/<%= r.requestId %>"
                                       class="btn btn-outline btn-sm">View Details</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-title">No Blood Requests Matching Criteria</div>
                    <p>There are no active blood requests for the selected filters.</p>
                </div>
            
        <% } %>
    </div>
</main>

<%- include('../common/footer', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
