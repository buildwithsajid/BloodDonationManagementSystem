<header class="top-navbar">
    <div class="navbar-inner">
        <a href="/" class="navbar-brand">
            <div class="brand-icon">+</div>
            <div>
                <span class="brand-name">BDMS</span>
                <span class="brand-sub">Blood Donation System</span>
            </div>
        </a>

        <ul class="navbar-menu">
            
                <% if (loggedInUser != null && loggedInUser.role == 'ADMIN') { %>
                    <li class="nav-item"><a href="/admin/dashboard">Admin Console</a></li>
                    <li class="nav-item"><a href="/blood-requests">Blood Requests</a></li>
                    <li class="nav-item"><a href="/donations/create">Record Donation</a></li>
                    <li class="nav-item"><a href="/donations">Donations</a></li>
                    <li class="nav-item"><a href="/donors/available">Search Donors</a></li>
                    <li class="nav-item"><a href="/blood-groups">Blood Groups</a></li>
                

                <% } else if (loggedInUser != null && loggedInUser.role == 'DONOR') { %>
                    <li class="nav-item"><a href="/donor/dashboard">Dashboard</a></li>
                    <li class="nav-item"><a href="/donor/profile">My Profile</a></li>
                    <li class="nav-item"><a href="/donations/my-history">Donation History</a></li>
                    <li class="nav-item"><a href="/donors/available">Search Donors</a></li>
                    <li class="nav-item"><a href="/blood-requests">Requests</a></li>
                

                <% } else { %>
                    <li class="nav-item"><a href="/donors/available">Search Donors</a></li>
                    <li class="nav-item"><a href="/blood-requests">Blood Requests</a></li>
                    <li class="nav-item"><a href="/blood-groups">Blood Groups</a></li>
                
            <% } %>
        </ul>

        <div class="navbar-user">
            
                <% if (loggedInUser != null) { %>
                    <div class="user-meta">
                        <div class="user-name"><%= loggedInUser.fullName %></div>
                        <span class="user-role-badge <%= loggedInUser.role == 'ADMIN' ? 'role-admin' : 'role-donor' %>">
                            <%= loggedInUser.role %>
                        </span>
                    </div>
                    <a href="/logout" class="btn-nav-login">Logout</a>
                
                <% } else { %>
                    <a href="/login" class="btn-nav-login">Login</a>
                    <a href="/register" class="btn-nav-cta">Register Donor</a>
                
            <% } %>
        </div>
    </div>
</header>
