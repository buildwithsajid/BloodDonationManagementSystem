<% var pageTitle = `Availability Audit History - BDMS`; %>
<%- include('../common/header', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
<%- include('../common/navbar', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>

<main class="main-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Availability History Log</h1>
            <p class="page-subtitle">Complete audit trail of availability updates for <%= donor.fullName %></p>
        </div>
        <a href="/donor/profile" class="btn btn-outline btn-sm">Back to Profile</a>
    </div>

    <div class="data-table-container">
        
            <% if (notEmpty(availabilityHistory)) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Audit ID</th>
                            <th>Previous Status</th>
                            <th>Updated Status</th>
                            <th>Updated By</th>
                            <th>Timestamp</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (availabilityHistory||[]).forEach(function(h){ %>
                            <tr>
                                <td>#<%= h.historyId %></td>
                                <td>
                                    
                                        <% if (h.previousStatus == null) { %>
                                            <span style="color: var(--text-light);">Initial Registration</span>
                                        
                                        <% } else if (h.previousStatus) { %>
                                            <span class="status-pill status-available">Available</span>
                                        
                                        <% } else { %>
                                            <span class="status-pill status-unavailable">Unavailable</span>
                                        
                                    <% } %>
                                </td>
                                <td>
                                    
                                        <% if (h.newStatus) { %>
                                            <span class="status-pill status-available">Available</span>
                                        
                                        <% } else { %>
                                            <span class="status-pill status-unavailable">Unavailable</span>
                                        
                                    <% } %>
                                </td>
                                <td><%= h.updatedByName %></td>
                                <td style="color: var(--text-secondary);"><%= h.updatedAt %></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-title">No Audit Records Found</div>
                    <p>There are no past availability status changes logged for this account.</p>
                </div>
            
        <% } %>
    </div>
</main>

<%- include('../common/footer', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
