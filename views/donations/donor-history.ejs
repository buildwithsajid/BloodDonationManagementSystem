<% var pageTitle = `Donor Donation History - BDMS`; %>
<%- include('../common/header', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
<%- include('../common/navbar', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>

<main class="main-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Donations by <%= donor %></h1>
            <p class="page-subtitle">Historical donation records for this donor</p>
        </div>
        <a href="/donations" class="btn btn-outline btn-sm">All Donations</a>
    </div>

    <div class="data-table-container">
        
            <% if (notEmpty(donations)) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Donation ID</th>
                            <th>Donation Date</th>
                            <th>Location</th>
                            <th>Remarks</th>
                            <th>Recorded By</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (donations||[]).forEach(function(dn){ %>
                            <tr>
                                <td>#<%= dn.donationId %></td>
                                <td><strong><%= dn.donationDate %></strong></td>
                                <td><%= dn.donationLocation %></td>
                                <td><%= notEmpty(dn.remarks) ? dn.remarks : '-' %></td>
                                <td><%= dn.recordedByName %></td>
                                <td>
                                    <a href="/donations/<%= dn.donationId %>" class="btn btn-outline btn-sm">Details</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-title">No Donations Found for <%= donor %></div>
                    <p>This donor does not have any recorded donations in the database.</p>
                </div>
            
        <% } %>
    </div>
</main>

<%- include('../common/footer', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
