<% var pageTitle = `Donation Details #${donation.donationId} - BDMS`; %>
<%- include('../common/header', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
<%- include('../common/navbar', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>

<main class="main-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Donation Record #<%= donation.donationId %></h1>
            <p class="page-subtitle">Verified blood donation certificate entry</p>
        </div>
        
            <% if (loggedInUser != null && loggedInUser.role == 'ADMIN') { %>
                <a href="/donations" class="btn btn-outline btn-sm">Back to All Donations</a>
            
            <% } else { %>
                <a href="/donations/my-history" class="btn btn-outline btn-sm">Back to My History</a>
            
        <% } %>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Donation Summary</h3>
            <span class="blood-badge lg"><%= donation.bloodGroup %></span>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">Donor Name</span>
                    <span class="info-value"><%= donation.donorName %> (Donor ID: #<%= donation.donorId %>)</span>
                </div>

                <div class="info-item">
                    <span class="info-label">Donation Date</span>
                    <span class="info-value"><strong><%= donation.donationDate %></strong></span>
                </div>

                <div class="info-item">
                    <span class="info-label">Blood Group</span>
                    <span class="info-value"><%= donation.bloodGroup %></span>
                </div>

                <div class="info-item">
                    <span class="info-label">Location / Facility</span>
                    <span class="info-value"><%= donation.donationLocation %></span>
                </div>

                <div class="info-item">
                    <span class="info-label">Verified By Admin</span>
                    <span class="info-value"><%= donation.recordedByName %></span>
                </div>

                <div class="info-item">
                    <span class="info-label">Clinical Remarks</span>
                    <span class="info-value"><%= notEmpty(donation.remarks) ? donation.remarks : 'None recorded' %></span>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../common/footer', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
