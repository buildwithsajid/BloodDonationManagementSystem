<% var pageTitle = `My Donation History - BDMS`; %>
<%- include('../common/header', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
<%- include('../common/navbar', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>

<main class="main-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">My Donation History</h1>
            <p class="page-subtitle">Your personal record of voluntary blood donations</p>
        </div>
        <a href="/donor/dashboard" class="btn btn-outline btn-sm">Dashboard</a>
    </div>

    <div class="data-table-container">
        
            <% if (notEmpty(donations)) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Donation ID</th>
                            <th>Donation Date</th>
                            <th>Location / Facility</th>
                            <th>Remarks</th>
                            <th>Recorded By</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (donations||[]).forEach(function(dn){ %>
                            <tr>
                                <td>#<%= dn.donationId %></td>
                                <td><strong><%= dn.donationDate %></strong></td>
                                <td><%= dn.donationLocation %></td>
                                <td style="color: var(--text-secondary);"><%= notEmpty(dn.remarks) ? dn.remarks : '-' %></td>
                                <td style="font-size: 13px; color: var(--text-secondary);"><%= dn.recordedByName %></td>
                                <td>
                                    <a href="/donations/<%= dn.donationId %>" class="btn btn-outline btn-sm">View Certificate</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-title">No Prior Donations Recorded</div>
                    <p>When you participate in a blood donation camp, your donation record will appear here after verification.</p>
                </div>
            
        <% } %>
    </div>
</main>

<%- include('../common/footer', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
