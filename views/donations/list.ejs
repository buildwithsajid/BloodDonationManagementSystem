<% var pageTitle = `All Blood Donations - BDMS`; %>
<%- include('../common/header', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
<%- include('../common/navbar', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>

<main class="main-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Blood Donation Records</h1>
            <p class="page-subtitle">Historical registry of all completed blood donations</p>
        </div>
        <a href="/donations/create" class="btn btn-primary btn-sm">
            + Record New Donation
        </a>
    </div>

    <% if (notEmpty(successMessage)) { %>
        <div class="alert alert-success">
            <span><%= successMessage %></span>
            <button type="button" class="alert-close">&times;</button>
        </div>
    <% } %>

    <div class="data-table-container">
        
            <% if (notEmpty(donations)) { %>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Donation ID</th>
                            <th>Donation Date</th>
                            <th>Donor Name</th>
                            <th>Blood Group</th>
                            <th>Location / Camp</th>
                            <th>Remarks</th>
                            <th>Recorded By</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% (donations||[]).forEach(function(dn){ %>
                            <tr>
                                <td>#<%= dn.donationId %></td>
                                <td><strong><%= dn.donationDate %></strong></td>
                                <td>
                                    <a href="/donations/donor/<%= dn.donorId %>" style="color: var(--primary); font-weight: 500; text-decoration: none;">
                                        <%= dn.donorName %>
                                    </a>
                                </td>
                                <td><span class="blood-badge"><%= dn.bloodGroup %></span></td>
                                <td><%= dn.donationLocation %></td>
                                <td style="color: var(--text-secondary);"><%= notEmpty(dn.remarks) ? dn.remarks : '-' %></td>
                                <td style="font-size: 13px; color: var(--text-secondary);"><%= dn.recordedByName %></td>
                                <td>
                                    <a href="/donations/<%= dn.donationId %>" class="btn btn-outline btn-sm">Details</a>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            
            <% } else { %>
                <div class="empty-state">
                    <div class="empty-state-title">No Donations Recorded Yet</div>
                    <p>Click "Record New Donation" above to log a verified donor contribution.</p>
                </div>
            
        <% } %>
    </div>
</main>

<%- include('../common/footer', {pageTitle: typeof pageTitle!=='undefined'?pageTitle:undefined}) %>
